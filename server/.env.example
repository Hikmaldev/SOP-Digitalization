# SOPly API — copy this file to .env and fill in real values.
# Never commit .env to version control.

NODE_ENV=development
PORT=4000

# Neon Postgres connection string (use the pooled endpoint).
# sslmode=verify-full is explicit and future-proof for node-postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# JWT auth — JWT_SECRET must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Uploads. The PRD leaves the object storage provider open; a local disk
# driver is used in development behind the StorageDriver interface.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Include the password-reset token in the API response (development only!)
EXPOSE_RESET_TOKEN=true
